#!/bin/bash
# Omarchy theme-set hook, run by `omarchy-hook theme-set <theme>` after every theme switch (so Omarchy's new
# terminal palette already exists). It regenerates this dotfiles repo's theme files (Otty, the Noctty fallback, and
# the Neovim theme.lua for the non-Omarchy machines, and the tiered starship prompt colours) from Omarchy's current
# theme, so the other machines can follow after you commit, push, and `chezmoi git -- pull && chezmoi apply` there.
#
# It writes files in the repo working tree: it never commits, never pushes, and never fails the theme switch
# (always exits 0). The one thing it applies to this machine is ~/.config/starship.toml (so the prompt changes live);
# that apply is plain `chezmoi apply` on that single file, never forced: if you edited the file by hand chezmoi refuses
# and says so in the log. The result of the last run is kept in ~/.local/state/dotfiles-theme-sync.log.
# Installed by chezmoi on Omarchy only; the generator is scripts/sync-omarchy-theme.py in the repo.
set -u
SRC="$(chezmoi source-path 2>/dev/null)"
[ -n "$SRC" ] || SRC="$HOME/.local/share/chezmoi"
GEN="$SRC/scripts/sync-omarchy-theme.py"
LOG="$HOME/.local/state/dotfiles-theme-sync.log"
mkdir -p "$(dirname "$LOG")" 2>/dev/null
[ -f "$GEN" ] || { echo "$(date -Is) theme '${1:-?}': generator not found at $GEN, nothing done" > "$LOG"; exit 0; }
{
  echo "$(date -Is) theme '${1:-?}'"
  python3 "$GEN" --repo "$SRC" 2>&1; st=$?
  echo "exit status: $st"
  if [ $st -eq 0 ] && command -v chezmoi >/dev/null 2>&1; then
    echo "apply: ~/.config/starship.toml"
    timeout 60 chezmoi apply --include=files "$HOME/.config/starship.toml" < /dev/null 2>&1
    echo "apply exit status: $?"
  fi
} > "$LOG" 2>&1 || true
exit 0
