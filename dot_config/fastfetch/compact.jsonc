// One-line summary for SSH sessions (see the fastfetch block in ~/.zshrc, which joins
// these lines with a separator). Values only: no logo, no keys.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": { "type": "none" },
  "display": { "separator": "", "key": { "type": "none" } },
  "modules": [
    { "type": "title", "keyType": "none", "format": "{#35}{user-name}{#90}@{#34}{host-name}" },
    { "type": "os",     "keyType": "none", "format": "{2} {8}" },
    { "type": "uptime", "keyType": "none", "format": "up {8}d {2}h" },
    { "type": "memory", "keyType": "none", "percent": { "type": 9, "green": 50, "yellow": 75 }, "format": "mem {3}" },
    { "type": "disk",   "keyType": "none", "folders": "/", "percent": { "type": 9, "green": 50, "yellow": 75 }, "format": "disk {3}" }
  ]
}
